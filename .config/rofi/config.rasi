configuration {
    font: "JetBrainsMono Nerd Font 14";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    modes: [ "drun", "combi" ];
    combi-modes: [ "drun", "run" ];
    drun-display-format: "{icon} {name}";
    sort: true;
    sorting-method: "fzf";
    disable-history: false;
    display-drun: "Apps";
    display-combi: "Combi";
    display-run: "💻 Ejecutar";
}

/* --- ESTILO ESTILO WAYBAR CORREGIDO --- */

* {
    /* Usamos HEX estándar para evitar errores de parseo */
    bg-base:     #2B303B; 
    bg-selected: #5A6EE0;   
    fg-main:     #FFFFFF;
    accent:      #5A6EE0;
    
    background-color: transparent;
    text-color: @fg-main;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    /* La transparencia la aplicamos aquí con el formato de Rofi */
    background-color: rgba(43, 48, 59, 85%); 
    border: 2px;
    border-color: @accent;
    border-radius: 18px;   
    width: 35%;
    padding: 20px;
}

inputbar {
    padding: 10px;
    margin: 0 0 15px 0;
    background-color: rgba(0, 0, 0, 20%);
    border-radius: 12px;
    children: [ prompt, entry ];
}

prompt {
    background-color: @accent;
    text-color: @fg-main;
    padding: 8px 15px;
    border-radius: 10px;
}

entry {
    padding: 8px;
    text-color: @fg-main;
}

listview {
    columns: 1;
    lines: 8;
    spacing: 8px;
    cycle: true;
    dynamic: true;
    layout: vertical;
    scrollbar: false;
}

element {
    padding: 12px;
    border-radius: 12px;
}

element selected {
    background-color: @bg-selected;
    text-color: @fg-main;
}

element-icon {
    size: 32px;
    padding: 0 15px 0 0;
}

element-text {
    vertical-align: 0.5;
}
