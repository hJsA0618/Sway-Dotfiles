###############################################################################
#                         JAVIER SWAY CONFIGURATION                           #
###############################################################################

# =============================================================================
# 1. VARIABLES Y PREFERENCIAS
# =============================================================================
set $mod Mod4
set $term kitty
set $left h
set $down j
set $up k
set $right l


# Lanzador de aplicaciones (Rofi)
set $menu rofi -show drun -modes "drun,combi" -terminal '$term'

#waybar
exec waybar -C ~/.config/waybar-sway

# Configuración de salida (Escalado y Wallpaper)
output * scale 1.25
# Usa la variable de entorno HOME para máxima portabilidad
output * bg $HOME/.config/sway/wallpapers/608170.jpg fill
#para cambiar de fondo cada que se inicie sesion
exec ~/.config/sway/cambiar_fondo.sh
bindsym $mod+Mod1+w exec ~/.config/sway/cambiar_fondo.sh

# Cursor de sistema
seat * xcursor_theme KayokoCursor 64

# =============================================================================
# 2. EJECUCIÓN AL INICIO (AUTOSTART)
# =============================================================================
# Notificaciones (Matamos mako y lanzamos SwayNC)
exec pkill mako; swaync
exec_always $HOME/.local/bin/autotiling

# Temas GTK y Apariencia de interfaz
exec_always {
    gsettings set org.gnome.desktop.interface gtk-theme 'Dream-Violet-Dark-GTK'
    gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark'
    gsettings set org.gnome.desktop.interface cursor-size 32
    gsettings set org.gnome.desktop.interface cursor-theme 'KayokoCursor'
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
}

# =============================================================================
# 3. ENTRADA (TECLADO Y MOUSE)
# =============================================================================
input "*" {
    xkb_layout "es,latam" 
}

# Cambiar distribución de teclado (Win + Ctrl + K) + Notificación
bindsym $mod+Control+k exec swaymsg input "*" xkb_switch_layout next && \
    notify-send "⌨️ Teclado" "Distribución: $(swaymsg -t get_inputs | jq -r '.[] | select(.type == \"keyboard\") | .xkb_active_layout_name' | head -n1)" -i input-keyboard -t 2000
input type:touchpad {
    natural_scroll enabled
    tap enabled
}

# =============================================================================
# 4. ATAJOS DE APLICACIONES (BINDSYMS)
# =============================================================================
bindsym $mod+Return  exec $term
bindsym $mod+d       exec $menu
bindsym $mod+t       exec thunar
bindsym $mod+b       exec brave-browser
bindsym $mod+Shift+n exec swaync-client -t -sw

# Gestión de Sesión
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+w exec wlogout -b 6
bindsym $mod+Escape  exec swaylock -f -i /home/javier/Imágenes/fondo/1102269.jpg
bindsym $mod+Shift+e exec swaynag -t warning -m '¿Deseas salir de Sway?' -B 'Sí, salir' 'swaymsg exit'

# Captura zona -> Portapapeles Y Carpeta de Imágenes
bindsym $mod+Shift+Print exec grim -g "$(slurp)" - | tee ~/Imágenes/captura_$(date +%Y%m%d_%H%M%S).png | wl-copy && \
    notify-send "📷 Captura" "Guardada en Imágenes y Portapapeles" -t 2000

# =============================================================================
# 5. GESTIÓN DE VENTANAS Y NAVEGACIÓN
# =============================================================================
# Cambio de foco (Vim-style)
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

# Cambio de foco (Flechas)
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

# Movimiento de ventanas (Vim-style)
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

# Movimiento de ventanas (Flechas)
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right

# =============================================================================
# 6. WORKSPACES Y LAYOUT
# =============================================================================

# Cambiar al siguiente/anterior espacio de trabajo con 3 dedos
bindgesture swipe:left workspace prev
bindgesture swipe:right workspace next

# // atajos opcionales // 
#			|
#			v

#indgesture swipe:down scratchpad show
#bindgesture swipe:up scratchpad show

# Permite mover los contenedores pellizcándolos
#bindgesture pinch:inward+up move up
#bindgesture pinch:inward+down move down
#bindgesture pinch:inward+left move left
#bindgesture pinch:inward+right move right

# Cambio de Workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Mover contenedor a Workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Navegación entre workspaces (Ctrl + Win + Flechas)
bindsym $mod+Control+Left  workspace prev_on_output
bindsym $mod+Control+Right workspace next_on_output

# Mover ventana a los worskpace de los lados (Ctrl + Win + Shift + Flechas)
bindsym $mod+Ctrl+Shift+Left move container to workspace prev, workspace prev
bindsym $mod+Ctrl+Shift+Right move container to workspace next, workspace next
bindsym $mod+Shift+b splith
bindsym $mod+Shift+v splitv
bindsym $mod+s       layout stacking
bindsym $mod+w       layout tabbed
bindsym $mod+e       layout toggle split
bindsym $mod+f       fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space       focus mode_toggle
bindsym $mod+a           focus parent

# =============================================================================
# 7. SCRATCHPAD (BAG OF HOLDING)
# =============================================================================
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus       scratchpad show

# =============================================================================
# 8. MODO REDIMENSIONAR (RESIZE)
# =============================================================================
mode "resize" {
    bindsym $left  resize shrink width 10px
    bindsym $down  resize grow height 10px
    bindsym $up    resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left   resize shrink width 10px
    bindsym Down   resize grow height 10px
    bindsym Up     resize shrink height 10px
    bindsym Right  resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# =============================================================================
# 9. APARIENCIA Y ESTÉTICA (AMETHYST VIBRANTE)
# =============================================================================
# Gaps (Espaciado)
gaps inner 10
gaps outer 4
smart_borders on

# Bordes de ventana
default_border pixel 4
floating_modifier $mod normal

# Esquema de Colores
# Estructura:            [borde]   [fondo]   [texto]   [indicador] [borde_hijo]
client.focused           #5A6EE0   #292F50   #ffffff   #87CEEB     #5A6EE0
client.focused_inactive  #1A1E33   #1A1E33   #888888   #1A1E33     #1A1E33
client.unfocused         #141726   #141726   #555555   #141726     #141726
client.urgent            #FF5555   #FF5555   #ffffff   #FF5555     #FF5555

# =============================================================================
# 10. INCLUDES EXTERNOS
# =============================================================================
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'


